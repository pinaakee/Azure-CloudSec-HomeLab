// ========================================================================================
// TITLE: Enterprise Threat Hunting & Detection Engineering Script Suite
// ENVIRONMENT: Microsoft Sentinel / Azure Log Analytics Workspace
// TARGET COMPONENT: Windows Security Events via Azure Monitor Agent (AMA)
// AUTHOR: Cybersecurity Lab Engineering Portfolio
// ========================================================================================

// ----------------------------------------------------------------------------------------
// USE CASE 1: INITIAL ACCESS & IDENTITY THREATS
// SCENARIO: Detecting Automated Brute-Force & Password Spray Attacks on Exposed Gateways
// ----------------------------------------------------------------------------------------

// Query 1.1: Top 10 External IP Addresses Driving Authentication Failures
// Objective: Isolate high-volume brute-force traffic origins trying to guess domain passwords.
SecurityEvent
| where TimeGenerated > ago(24h)
| where EventID == 4625 // Filter specifically for failed logon events
| where IpAddress != "-" and isnotempty(IpAddress)
| summarize FailureCount = count() by IpAddress, TargetAccount, LogonTypeName
| top 10 by FailureCount desc;

// Query 1.2: RDP Password Spraying Detection Rule
// Objective: Identify external IPs testing one password against multiple distinct accounts within a short window.
SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4625
| where LogonType == 10 // Logon Type 10 signifies an Interactive Remote Desktop (RDP) session
| summarize TargetedAccountsCount = dcount(TargetAccount), AccountList = make_set(TargetAccount) by IpAddress
| where TargetedAccountsCount >= 5 // Flag if an attacker enumerates 5 or more unique accounts
| order by TargetedAccountsCount desc;

// Query 1.3: Anomaly Check - Successful Logons Post Repeated Failures
// Objective: Spot a high-risk security alert scenario where a brute-force attack successfully breaches an account.
let FailureThreshold = 10;
let BruteForcers = SecurityEvent
| where TimeGenerated > ago(4h)
| where EventID == 4625
| summarize FailCount = count() by IpAddress, TargetAccount
| where FailCount >= FailureThreshold;
BruteForcers
| join kind=inner (
    SecurityEvent
    | where TimeGenerated > ago(4h)
    | where EventID == 4624 // Filter specifically for successful logon events
) on IpAddress, TargetAccount
| project TimeGenerated, IpAddress, TargetAccount, FailCount, Computer, AuthenticationPackageName
| rename SuccessTime = TimeGenerated;


// ----------------------------------------------------------------------------------------
// USE CASE 2: PRIVILEGE ESCALATION & PERSISTENCE
// SCENARIO: Monitoring Unauthorized Account Modifications and Backdoors
// ----------------------------------------------------------------------------------------

// Query 2.1: Rogue Local Administrator Group Additions
// Objective: Capture threat actors establishing persistent local backdoor access on compromised targets.
SecurityEvent
| where TimeGenerated > ago(7d)
| where EventID == 4732 // EventID 4732 indicates a member was added to a security-enabled local group
| extend TargetGroup = MemberName, AddedUser = TargetUserName
| where TargetGroup contains "Administrators"
| project TimeGenerated, Computer, TargetGroup, AddedUser, SubjectUserName, AccountType
| order by TimeGenerated desc;

// Query 2.2: Cleared Security Event Logs (Anti-Forensics Triage)
// Objective: Flag defense evasion tactics where an attacker attempts to wipe audit trails to hide footprints.
SecurityEvent
| where TimeGenerated > ago(30d)
| where EventID == 1102 // EventID 1102 triggers explicitly when the audit log is cleared
| project TimeGenerated, Computer, Account, Activity, ManagementGroupName
| order by TimeGenerated desc;


// ----------------------------------------------------------------------------------------
// USE CASE 3: DEFENSIVE METRICS & HEALTH MONITORING
// SCENARIO: Baselining Telemetry Stream Volume to Spot Logging Outages
// ----------------------------------------------------------------------------------------

// Query 3.1: Hourly Log Ingestion Volume Baseline
// Objective: Monitor operational pipelines to discover architectural failures, offline agents, or network drops.
SecurityEvent
| where TimeGenerated > ago(7d)
| summarize IngestionVolumeCount = count() by bin(TimeGenerated, 1h), Computer
| order by TimeGenerated desc;
